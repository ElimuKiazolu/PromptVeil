{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "erasableSyntaxOnly": true
  },
  "include": ["./**/*.ts", "./**/*.tsx", "./.wxt/wxt.d.ts"],
  "exclude": ["./node_modules", "./.output", "./coverage"]
}
